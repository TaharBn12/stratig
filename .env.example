# ═══════════════════════════════════════════════════════════
#  انسخ هذا الملف باسم .env ثم املأ القيم:  cp .env.example .env
#  لا ترفع ملف .env إلى Git أبداً
# ═══════════════════════════════════════════════════════════

# ─────────── تليجرام ───────────
# 1) أنشئ بوت عبر @BotFather ثم الصق التوكن هنا
TELEGRAM_BOT_TOKEN=9068383353:AAEGXAEUpOCy-cdGTGZpy05aADxegQJs3b0

# 2) معرف/معرفات المستخدمين المسموح لهم بالتحكم (chat id)
#    لمعرفة الـ id أرسل /id للبوت، أو استخدم @userinfobot
#    أكثر من مستخدم: افصل بفاصلة 123456789,987654321
#    اتركه فارغاً للسماح للجميع (غير موصى به)
TELEGRAM_CHAT_IDS=5265226396

# ─────────── المنصة ───────────
# binance  أو  bybit
EXCHANGE=binance

# true = تيستنت (أموال وهمية)  |  false = تداول حقيقي
TESTNET=true

# ─────────── مفاتيح Binance ───────────
# مفاتيح التيستنت من: https://testnet.binancefuture.com
BINANCE_TESTNET_API_KEY=wxDgxX94mKsCOdKSbb4Hgj6VvqMhKn0yadB0u1tOPe3SFcZzV8HvIB9FgZv2pk94
BINANCE_TESTNET_API_SECRET=9RJvPprBOh4JdlcHa3l4U2TjO1Funs2it46Mi4YejhYHBzibc00uYF1SId3ThR0p


https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=wxDgxX94mKsCOdKSbb4Hgj6VvqMhKn0yadB0u1tOPe3SFcZzV8HvIB9FgZv2pk94
BINANCE_API_SECRET=9RJvPprBOh4JdlcHa3l4U2TjO1Funs2it46Mi4YejhYHBzibc00uYF1SId3ThR0p

# ─────────── مفاتيح Bybit (اختياري) ───────────
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ─────────── محاكاة (اختياري) ───────────
# true  = لا تُرسل أي أوامر (تحليل فقط)
# false = نفّذ أوامر حقيقية   ← الافتراضي، وهو ما تريده عادةً
# ملاحظة: هذا يطغى على safety.dry_run في config.toml.
# ويمكن تغييره من تليجرام في أي لحظة بـ /live و /dryrun
DRY_RUN=false

# ─────────── أمان إضافي ───────────
# عند التشغيل على الشبكة الحقيقية (TESTNET=false) يجب تعيين هذا إلى 1
CONFIRM_LIVE_TRADING=0

# مستوى اللوج: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
