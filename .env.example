# ═══════════════════════════════════════════════════════════
#  انسخ هذا الملف باسم .env ثم املأ القيم:  cp .env.example .env
#  لا ترفع ملف .env إلى Git أبداً
# ═══════════════════════════════════════════════════════════

# ─────────── تليجرام ───────────
# 1) أنشئ بوت عبر @BotFather ثم الصق التوكن هنا
TELEGRAM_BOT_TOKEN=

# 2) معرف/معرفات المستخدمين المسموح لهم بالتحكم (chat id)
#    لمعرفة الـ id أرسل /id للبوت، أو استخدم @userinfobot
#    أكثر من مستخدم: افصل بفاصلة 123456789,987654321
#    اتركه فارغاً للسماح للجميع (غير موصى به)
TELEGRAM_CHAT_IDS=

# ─────────── المنصة ───────────
# binance  أو  bybit
EXCHANGE=binance

# true = تيستنت (أموال وهمية)  |  false = تداول حقيقي
TESTNET=true

# ─────────── مفاتيح Binance ───────────
# مفاتيح التيستنت من: https://testnet.binancefuture.com
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# مفاتيح التداول الحقيقي من: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ─────────── مفاتيح Bybit (اختياري) ───────────
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# ─────────── أمان إضافي ───────────
# عند التشغيل على الشبكة الحقيقية (TESTNET=false) يجب تعيين هذا إلى 1
CONFIRM_LIVE_TRADING=0

# مستوى اللوج: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
